database/
*.db
*.db-shm
*.db-wal

# Sicherungen
backups/

# Ausgaben und Protokolle
exports/
logs/
*.log

# Ergebnisse des Android-Baus
.buildozer/
bin/

# Python
__pycache__/
*.pyc
*.pyo

# PyCharm
.idea/
